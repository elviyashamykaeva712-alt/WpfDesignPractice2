<Application x:Class="WpfDesignPractice2.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfDesignPractice2"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>


            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>


            <!-- Цветовая палитра -->
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF6A11CB"/>
            <SolidColorBrush x:Key="SecondaryBrush" Color="#FF2575FC"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FFFF5252"/>
            <SolidColorBrush x:Key="SuccessBrush" Color="#FF4CAF50"/>
            <SolidColorBrush x:Key="WarningBrush" Color="#FFFF9800"/>
            <SolidColorBrush x:Key="DarkBrush" Color="#FF333333"/>
            <SolidColorBrush x:Key="LightBrush" Color="#FFF5F5F5"/>
            <!-- Типографика -->
            <FontFamily x:Key="MainFont">Segoe UI</FontFamily>
            <sys:Double x:Key="FontSizeH1">28</sys:Double>
            <sys:Double x:Key="FontSizeH2">22</sys:Double>
            <sys:Double x:Key="FontSizeH3">18</sys:Double>
            <sys:Double x:Key="FontSizeBody">14</sys:Double>
            <sys:Double x:Key="FontSizeCaption">12</sys:Double>
            <sys:Double x:Key="FontSizeButton">14</sys:Double>
            <!-- Дополнительные ресурсы -->
            <CornerRadius x:Key="ControlCornerRadius">5</CornerRadius>
            <Thickness x:Key="DefaultPadding">10</Thickness>
        </ResourceDictionary>
        
        
    </Application.Resources>
</Application>
